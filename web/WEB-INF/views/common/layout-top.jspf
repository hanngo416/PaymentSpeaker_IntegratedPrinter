<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:set var="me" value="${sessionScope.loginUser}"/>
<c:set var="role" value="${me.role}"/>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light only">
    <title><c:out value="${pageTitle}"/></title>
    <link rel="stylesheet" href="${ctx}/assets/css/app.css?v=37">
    <script>
        (function () {
            try {
                if (localStorage.getItem('tinky_sidebar_collapsed') === '1') {
                    document.documentElement.classList.add('sidebar-collapsed');
                }
            } catch (e) {}
        })();
    </script>
</head>
<body>
<div class="shell" id="appShell">
    <aside class="sidebar" id="appSidebar">
        <div>
            <div class="brand">
                <div class="brand-left">
                    <div class="brand-mark">T</div>
                    <span class="brand-name">Tinky</span>
                </div>
            </div>
            <input type="checkbox" id="navToggle" class="nav-toggle" aria-hidden="true" tabindex="-1" style="display:none;">
            <label for="navToggle" class="nav-burger" aria-label="Menu">
                <span></span><span></span><span></span>
            </label>
            <nav class="nav">
                <a href="${ctx}/home" class="${nav == 'home' ? 'active' : ''}" title="Home">
                    <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                    <span class="nav-text">Home</span>
                </a>
                <a href="${ctx}/guide" class="${nav == 'guide' ? 'active' : ''}" title="Starter Guide">
                    <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
                    <span class="nav-text">Starter Guide</span>
                </a>
                <c:if test="${role == 'CASHIER' || role == 'ADMIN' || role == 'STORE_MANAGER' || role == 'AUDITOR'}">
                    <div class="nav-section-title">Operations</div>
                </c:if>
                <c:if test="${role == 'CASHIER' || role == 'ADMIN'}">
                    <a href="${ctx}/orders/new" class="${nav == 'orders' ? 'active' : ''}" title="Point of Sale">
                        <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                        <span class="nav-text">Point of Sale</span>
                    </a>
                </c:if>
                <c:if test="${role == 'CASHIER' || role == 'ADMIN' || role == 'STORE_MANAGER'}">
                    <a href="${ctx}/shift" class="${nav == 'shift' ? 'active' : ''}" title="Shift">
                        <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        <span class="nav-text">Shift</span>
                    </a>
                </c:if>
                <c:if test="${role == 'ADMIN' || role == 'AUDITOR'}">
                    <a href="${ctx}/reports/shifts" class="${nav == 'invoices' ? 'active' : ''}" title="Shift Reports">
                        <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                        <span class="nav-text">Shift Reports</span>
                    </a>
                </c:if>
                <c:if test="${role == 'ADMIN' || role == 'STORE_MANAGER'}">
                    <a href="${ctx}/admin/products" class="${nav == 'products' ? 'active' : ''}" title="Catalog">
                        <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                        <span class="nav-text">Catalog</span>
                    </a>
                    <a href="${ctx}/admin/discounts" class="${nav == 'discounts' ? 'active' : ''}" title="Discount codes">
                        <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                        <span class="nav-text">Discount codes</span>
                    </a>
                </c:if>

                <c:if test="${role == 'ADMIN' || role == 'STORE_MANAGER'}">
                    <div class="nav-section-title">Omnichannel</div>
                    <a href="${ctx}/sales" class="${nav == 'sales' ? 'active' : ''}" title="Sales book">
                        <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                        <span class="nav-text">Sales Book</span>
                    </a>
                    <a href="${ctx}/analytics" class="${nav == 'analytics' ? 'active' : ''}" title="Channel Analytics">
                        <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                        <span class="nav-text">Channel Analytics</span>
                    </a>
                </c:if>

                <c:if test="${role == 'ADMIN' || role == 'STORE_MANAGER' || role == 'AUDITOR' || not empty myAffiliate}">
                    <div class="nav-section-title">Marketing</div>
                </c:if>
                <c:if test="${role == 'ADMIN' || role == 'STORE_MANAGER'}">
                    <a href="${ctx}/admin/affiliate-overview" class="${nav == 'affiliates' ? 'active' : ''}" title="Affiliate program">
                        <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        <span class="nav-text">Affiliates</span>
                    </a>
                </c:if>
                <c:if test="${role == 'AUDITOR'}">
                    <a href="${ctx}/admin/channel-reports" class="${nav == 'affiliates' ? 'active' : ''}" title="Affiliate reports">
                        <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                        <span class="nav-text">Affiliate reports</span>
                    </a>
                </c:if>
                <c:if test="${not empty myAffiliate}">
                    <a href="${ctx}/affiliate/portal" class="${nav == 'portal' ? 'active' : ''}" title="My affiliate page">
                        <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        <span class="nav-text">My Affiliate</span>
                    </a>
                </c:if>

                <c:if test="${role != 'TECHNICIAN' && role != 'AFFILIATE'}">
                    <div class="nav-section-title">Finance & Tax</div>
                    <a href="${ctx}/transactions" class="${nav == 'transactions' ? 'active' : ''}" title="Bank Ledger">
                        <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                        <span class="nav-text">Bank Ledger</span>
                    </a>
                </c:if>
                <c:if test="${role == 'ADMIN' || role == 'STORE_MANAGER' || role == 'AUDITOR'}">
                    <a href="${ctx}/alerts" class="${nav == 'alerts' ? 'active' : ''}" title="Alert Center">
                        <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                        <span class="nav-text">Alert Center</span>
                    </a>
                </c:if>
                <c:if test="${role == 'ADMIN' || role == 'STORE_MANAGER'}">
                    <a href="${ctx}/tax" class="${nav == 'tax' ? 'active' : ''}" title="Tax 2026">
                        <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="5" x2="5" y2="19"></line><circle cx="6.5" cy="6.5" r="2.5"></circle><circle cx="17.5" cy="17.5" r="2.5"></circle></svg>
                        <span class="nav-text">Tax 2026</span>
                    </a>
                    <a href="${ctx}/invoices/manage" class="${nav == 'einvoices' ? 'active' : ''}" title="E-Invoices">
                        <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
                        <span class="nav-text">E-Invoices</span>
                    </a>
                </c:if>

                <div class="nav-section-title">System</div>
                <c:if test="${role == 'ADMIN' || role == 'STORE_MANAGER'}">
                    <a href="${ctx}/admin/users" class="${nav == 'users' ? 'active' : ''}" title="Users">
                        <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        <span class="nav-text">Users</span>
                    </a>
                </c:if>
                <c:if test="${role == 'ADMIN' || role == 'AUDITOR'}">
                    <a href="${ctx}/admin/audit" class="${nav == 'audit' ? 'active' : ''}" title="Audit Log">
                        <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>
                        <span class="nav-text">Audit Log</span>
                    </a>
                </c:if>
                <c:if test="${role == 'ADMIN' || role == 'STORE_MANAGER' || role == 'CASHIER' || role == 'TECHNICIAN'}">
                    <a href="${ctx}/settings" class="${nav == 'settings' ? 'active' : ''}" title="Settings & Hardware">
                        <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                        <span class="nav-text">Settings</span>
                    </a>
                </c:if>
                <a href="${ctx}/profile" class="${nav == 'profile' ? 'active' : ''}" title="Profile">
                    <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    <span class="nav-text">Profile</span>
                </a>
            </nav>
        </div>
        <div class="sidebar-foot">
            <div class="sidebar-user">
                <span class="avatar"><c:out value="${fn:toUpperCase(fn:substring(me.fullName, 0, 1))}"/></span>
                <div class="user-meta">
                    <span class="user-name" title="<c:out value='${me.fullName}'/>"><c:out value="${me.fullName}"/></span>
                    <span class="user-role-pill"><c:out value="${role}"/></span>
                </div>
            </div>
            <form method="post" action="${ctx}/logout" class="sidebar-logout">
                <button type="submit" title="Logout">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    <span>Logout</span>
                </button>
            </form>
        </div>
    </aside>
    <div class="main">
        <header class="topbar">
            <div style="display: flex; align-items: center;">
                <button type="button" class="topbar-sidebar-btn" id="topbarSidebarBtn" aria-label="Toggle sidebar" title="Toggle sidebar">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>
                <div class="topbar-title"><c:out value="${pageTitle}"/></div>
            </div>
        </header>
        <main class="content">
            <c:if test="${newAlertCount > 0 && (role == 'ADMIN' || role == 'STORE_MANAGER' || role == 'CASHIER')}">
                <div class="alert-banner">
                    <span>${newAlertCount} transaction(s) need checking.</span>
                    <c:choose>
                        <c:when test="${role == 'CASHIER'}"><a href="${ctx}/transactions">View transactions</a></c:when>
                        <c:otherwise><a href="${ctx}/alerts">Open alert center</a></c:otherwise>
                    </c:choose>
                </div>
            </c:if>
<script>
    (function () {
        function toggleSidebar(e) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            var html = document.documentElement;
            var isCol = html.classList.toggle('sidebar-collapsed');
            try {
                localStorage.setItem('tinky_sidebar_collapsed', isCol ? '1' : '0');
            } catch (err) {}
            var title = isCol ? 'Expand sidebar' : 'Collapse sidebar';
            var b2 = document.getElementById('topbarSidebarBtn');
            if (b2) b2.setAttribute('title', title);
        }

        var btn2 = document.getElementById('topbarSidebarBtn');
        if (btn2) btn2.addEventListener('click', toggleSidebar);
    })();
</script>
