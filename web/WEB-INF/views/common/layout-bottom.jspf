        </main>
    </div>
</div>
<c:if test="${role == 'CASHIER' || role == 'ADMIN' || role == 'STORE_MANAGER'}">
<div class="modal-backdrop" id="payPopup" hidden>
    <div class="modal" role="alertdialog" aria-modal="true" aria-labelledby="payTitle">
        <p class="modal-kicker" id="payTitle">Payment received</p>
        <div class="modal-amount" id="payAmount"></div>
        <dl>
            <dt>Order</dt><dd id="payOrder"></dd>
            <dt>Time</dt><dd id="payTime"></dd>
        </dl>
        <p class="hint" id="payMore"></p>
        <button type="button" class="primary" id="payOk">OK</button>
    </div>
</div>
<div id="announcer" hidden data-poll-url="${ctx}/speaker/poll" data-ack-url="${ctx}/speaker/ack"></div>
<script src="${ctx}/assets/js/announcer.js" charset="UTF-8"></script>
</c:if>
