        </main>
    </div>
</div>
<c:if test="${role == 'CASHIER' || role == 'ADMIN' || role == 'STORE_MANAGER'}">
<div class="modal-backdrop" id="payPopup" hidden>
    <div class="modal" role="alertdialog" aria-modal="true" aria-labelledby="payTitle">
        <p class="modal-kicker" id="payTitle">Payment received</p>
        <div class="modal-amount" id="payAmount"></div>
        <dl>
            <dt>Order</dt><dd id="payOrder"></dd>
            <dt>Time</dt><dd id="payTime"></dd>
        </dl>
        <p class="hint" id="payMore"></p>
        <button type="button" class="primary" id="payOk">OK</button>
    </div>
</div>
<div id="announcer" hidden data-poll-url="${ctx}/speaker/poll" data-ack-url="${ctx}/speaker/ack" data-print-url="${ctx}/printer/print"></div>
<script src="${ctx}/assets/js/announcer.js?v=4" charset="UTF-8"></script>
</c:if>
<div class="tax-bot level0" id="taxBot" data-feed-url="<c:if test="${role == 'ADMIN' || role == 'STORE_MANAGER'}">${ctx}/bot/feed</c:if>" data-chat-url="${ctx}/bot/chat" data-ctx="${ctx}">
    <div class="bot-panel" id="botPanel" hidden>
        <div class="bot-head">Assistant</div>
        <p class="bot-status" id="botStatus"></p>
        <div class="bot-messages" id="botMessages"></div>
        <div class="bot-chat" id="botChat"></div>
        <form class="bot-form" id="botForm" autocomplete="off">
            <input type="text" id="botInput" maxlength="500" placeholder="Ask about sales, orders, tax...">
            <button type="submit" class="primary" id="botSend">Send</button>
            <button type="button" class="btn" id="botClear">Clear</button>
        </form>
    </div>
    <button type="button" class="bot-toggle" id="botToggle" aria-label="Assistant" title="Assistant">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
        <span class="bot-dot" id="botDot" hidden></span>
    </button>
</div>
<script src="${ctx}/assets/js/bot.js?v=4" charset="UTF-8"></script>
